# A relativistic bunch through a square corrugated metal pipe (C4 symmetry: mode m couples with m +- 4; block metal,
# docs/specs/rz_metal_phi.md): half-width 0.8 mm at the teeth and 1.0 mm in the grooves, period 400 um with 200 um teeth
# and grooves, metal everywhere outside (a closed pipe; the radial absorber at 2.6 .. 3.0 mm lies inside the metal).
# The structure runs from z = 6 mm to 46 mm.
# A 1 nC electron bunch at gamma = 2000 (sigma_z 100 um, sigma_r 25 um; mass x 1e4: rigid) with its self-field starts in
# vacuum before the structure, offset by x0 (0: modes 0, 4, 8, .. only; x0 > 0: also 1, 3, 5, ..). The window moves at c.
#   build/vlpl examples/rz_square_pipe.deck                           (centred, 17 modes)
#   build/vlpl examples/rz_square_pipe.deck "species bunch.density_function=gauss(z - 4.5 mm, 100 um) * gauss(sqrt((x - 100 um)^2 + y^2), 25 um)" "species bunch.rmax=0.4mm"
# 17 modes put 33 angles on the circle (dphi = 0.19 rad: 152 um at r = 0.8 mm). The axis cut
# keeps dz at 0.75 dr (without it dz ~ dr / 8).
grid {
  geometry   = rz
  modes      = 17
  lambda0    = 100 um
  nz         = 400               # 6.0 mm window
  nr         = 150
  dz         = 15 um             # dz^2 lambda_max / 4 = 0.89 with the axis cut
  dr         = 20 um             # R = 3 mm
  boundary_z = open
  boundary_r = absorbing
  r_absorber_cells = 20          # 0.4 mm
  t_end      = 160 ps            # 48 mm: the bunch leaves the structure at 46 mm
}

numerics {
  solver      = rip_cc
  pusher      = boris
  rz_axis_cut = 1                # mode m >= 2 zero inside r < m_eff dr (decision 103)
}

window {
  start    = 0 fs
  velocity = 1
}

metal {
  # the half-width of the square: 0.8 mm where (z - 6 mm) mod 400 um < 200 um (teeth), 1.0 mm in the grooves
  function = z >= 6 mm && z < 46 mm && max(abs(x), abs(y)) > ((z - 6 mm - 400 um * floor((z - 6 mm) / (400 um))) < 200 um ? 0.8 mm : 1.0 mm)
}

species bunch {
  charge     = -1
  mass       = 1e4
  density    = 0.05687           # 1 nC: n_c(100 um) = 1.1149e23 m^-3, N = n n_c (2 pi)^1.5 sigma_z sigma_r^2
  density_function = gauss(z - 4.5 mm, 100 um) * gauss(r, 25 um)
  zmin       = 4.0 mm
  zmax       = 5.0 mm
  rmax       = 0.25 mm
  uz         = 2000
  self_field = true
  ppc_z      = 1
  ppc_r      = 2
  ppc_theta  = 34
}

output {
  dir           = out_rz_square_pipe
  every         = 100
  openpmd_every = 700
  openpmd_fields = E B
  axis_every    = 100
}
