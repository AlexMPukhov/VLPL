# A flying focus (luminal Bessel pulse) in a uniform background plasma (docs/specs/side_injection.md, decision 63): the
# incident pulse is that of the plasma (k_perp^2 = 2 omega kappa - kappa^2 - wp^2 in the continuum, the exact discrete
# waves of the solver with the cold fluid), fed through the faces of the side TFSF tube. Inside the kinetic region (the
# particles end 2 cells inside the faces) the electrons are particles; outside it, through the faces to the CPML, the
# plasma is a linear cold fluid, so the faces lie in the same plasma as the incident wave (real hydrogen is ionised far
# out). The pulse is present at t = 0 while the electrons start at rest: a transient until the window has moved its length.
#   build/vlpl examples/side_plasma.deck
grid {
  lambda0    = 0.8 um
  nx         = 480             # 24 um, 16 cells per wavelength (c dt = dx)
  ny         = 48
  nz         = 48
  dx         = 0.05 um
  dy         = 0.1 um
  dz         = 0.1 um
  boundary_x = open
  boundary_y = pml
  boundary_z = pml
  t_end      = 20 fs
}

pml {
  cells = 8
}

window {
  start    = 0 fs              # at c from t = 0: needed by the tabulated flying focus
  velocity = 1
}

side {
  wave               = flying_focus
  a0                 = 1
  cone_angle         = 20 deg
  length_1e          = 1.8 um
  x_center           = 12 um
  polarization       = y
  background_density = 0.01    # n_c, the same as the electrons below
}

species electrons {            # the kinetic region: total-field nodes 10..37, particles 12..35 (1.2 .. 3.5 um)
  charge  = -1
  mass    = 1
  density = 0.01
  ymin    = 1.2 um
  ymax    = 3.5 um
  zmin    = 1.2 um
  zmax    = 3.5 um
}

species protons {
  charge  = 1
  mass    = 1836
  mobile  = false
  density = 0.01
  ymin    = 1.2 um
  ymax    = 3.5 um
  zmin    = 1.2 um
  zmax    = 3.5 um
}

output {
  dir   = out_side_plasma
  every = 20
}
