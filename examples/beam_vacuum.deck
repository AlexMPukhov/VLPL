# A relativistic electron beam (200 MeV, 15 pC) in vacuum, started with its steady self-field
# (self_field = true, docs/specs/beam_self_field.md): the beam and its field move together, and the
# Gauss law holds to round-off from the first step (max|dGauss|, column 6 of diag.txt).
#   build/vlpl examples/beam_vacuum.deck
grid {
  lambda0    = 0.8 um
  nx         = 128             # 6.4 um
  ny         = 48              # 9.6 um
  nz         = 48
  dx         = 0.05 um
  dy         = 0.2 um
  dz         = 0.2 um
  boundary_x = open
  t_end      = 10 fs
}

numerics {
  shape  = 2
}

species beam {
  charge  = -1
  mass    = 1
  density = 0.05               # n_c, peak
  ux      = 400                # gamma ~ 400
  ppc_x   = 2
  ppc_y   = 2
  ppc_z   = 2
  # Gaussian, sigma_x = 0.3 um, sigma_r = 0.5 um, cut at 5 sigma
  density_function = gauss(x - 1.6 um, 0.3 um) * gauss(sqrt((y - 4.8 um)^2 + (z - 4.8 um)^2), 0.5 um) * (abs(x - 1.6 um) < 1.5 um) * (sqrt((y - 4.8 um)^2 + (z - 4.8 um)^2) < 2.5 um)
  self_field = true
}

output {
  dir   = out_beam
  every = 10
}
