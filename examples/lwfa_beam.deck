# Laser wakefield in a moving window with an externally injected witness beam: a short pulse
# (a0 = 2.5, 10 fs, waist 4 um) enters through the open left boundary, the window starts at speed c
# once the pulse is in (40 fs, decision 22), the plasma (n = 0.01 n_c, lambda_p ~ 8 um) enters at the
# right edge from x = 13 um on, and at 100 fs a 200 MeV, 16 pC electron beam is loaded 3.5 um behind
# the pulse centre with its steady self-field (docs/specs/beam_self_field.md).
#   build/vlpl examples/lwfa_beam.deck
#   python3 tools/movie.py out_lwfa_beam --fields Ex n_electrons n_beam
grid {
  lambda0    = 0.8 um
  nx         = 256             # 12.8 um, 16 cells per wavelength (c dt = dx)
  ny         = 64              # 12.8 um
  nz         = 64
  dx         = 0.05 um
  dy         = 0.2 um
  dz         = 0.2 um
  boundary_x = open
  t_end      = 200 fs
}

numerics {
  shape  = 2
  pusher = higuera_cary
}

laser {
  a0           = 2.5
  polarization = z
  duration     = 10 fs         # intensity FWHM; delay = 20 fs (default 2 duration)
  waist        = 4 um          # focus at the entrance plane x = 0, centred in y and z
  waist_z      = 4 um          # round (0 would be uniform in z)
}

window {
  start    = 40 fs             # >= 2 delay: the pulse has entered
  velocity = 1                 # c: one cell per step
}

species electrons {
  charge  = -1
  mass    = 1
  density = 0.01               # n_c
  xmin    = 13 um              # absolute x: enters with the window
  # density_function = x < 20 um ? (x - 13 um) / (7 um) : 1   # optional up-ramp (also for the protons)
}

species protons {
  charge  = 1
  mass    = 1836
  density = 0.01
  xmin    = 13 um
}

species beam {
  charge  = -1
  mass    = 1
  density = 0.05               # n_c, peak
  ux      = 400                # 200 MeV
  ppc_x   = 2
  ppc_y   = 2
  ppc_z   = 2
  # at t_start the window covers x = 18 .. 30.8 um and the pulse centre is at 24 um (absolute x)
  density_function = gauss(x - 20.5 um, 0.3 um) * gauss(sqrt((y - 6.4 um)^2 + (z - 6.4 um)^2), 0.5 um) * (abs(x - 20.5 um) < 1.5 um) * (sqrt((y - 6.4 um)^2 + (z - 6.4 um)^2) < 2.5 um)
  self_field = true
  t_start    = 100 fs
}

output {
  dir          = out_lwfa_beam
  every        = 20
  slice_every  = 100
  slice_fields = Ez Ex n_electrons n_beam
}
