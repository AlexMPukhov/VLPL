# VLPL side of the collision benchmark "ion" against Smilei 5.1 (bench/collisions_smilei/README.md): the parameters of
# smilei_coll.py (CASE=ion), frozen species (mobile = false): only the collisions act. Output: collisions.txt.
grid {
  geometry = cartesian2d
  lambda0 = 1 um
  nx = 5
  ny = 4
  dx = 0.05 um
  dy = 0.1 um
  dz = 1 um
  t_end = 333.564 fs
}
numerics {
  seed = 7
}
species electron {
  charge = -1
  mass = 1
  mobile = false
  density = 1
  ppc_x = 20
  ppc_y = 20
  ux = 0.0300135078
  uth_x = 0.000316227766
  uth_y = 0.000316227766
  uth_z = 0.000316227766
}
species ion {
  element = Al
  charge_state = 3
  mass = 23868
  mobile = false
  density = 0.333333333333
  ppc_x = 20
  ppc_y = 20
  uth_x = 6.4729e-7
  uth_y = 6.4729e-7
  uth_z = 6.4729e-7
}
collisions ei {
  species1 = electron
  species2 = ion
  coulomb_log = 3
  ionizing = true
}
output {
  dir = out_vlpl_ion
  every = 40
}
