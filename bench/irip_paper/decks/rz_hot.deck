# RZ hot plasma column in a conducting cylinder, box iRIP, modes 0..2, dz/dr = 4 (paper, task 8)
# lambda0 = 2 pi um: lengths in 1/k0 = um, times in 1/omega0 = 3.3356 fs
grid {
  geometry = rz
  modes    = 3
  lambda0  = 6.283185307 um
  nz       = 16
  nr       = 24
  dz       = 0.4 um
  dr       = 0.1 um
  t_end    = 800.6 fs           # 600 steps of 0.4 / omega0
}
numerics {
  solver = irip
  pusher = boris
}
species e {
  charge = -1
  mass = 1
  density = 0.25               # omega_p dt = 0.2
  rmax = 1.4 um
  ppc_r = 2
  ppc_theta = 12
  uth_z = 0.3
  uth_x = 0.3
  uth_y = 0.3
  uz = 0.1
}
species i {
  charge = 1
  mass = 10
  density = 0.25
  rmax = 1.4 um
  ppc_r = 2
  ppc_theta = 12
  uth_z = 0.05
  uth_x = 0.05
  uth_y = 0.05
}
output {
  dir = rz_hot_out
}
