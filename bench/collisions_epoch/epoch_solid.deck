# EPOCH 4.20 side of the solid-density benchmark (bench/collisions_epoch/README.md): hydrogen at n_e = n_i = 100 n_c
# (lambda = 1 um), T_e = 100 eV, T_i = 10 eV, lnL = 5 for all pairs (collide = all), 0.5 ps. Full PIC in 1D: dx = 0.25 nm
# (1.1 Debye lengths), cubic B-spline shape (epoch1d built with PARTICLE_SHAPE_BSPLINE3), periodic; run_epoch.sbatch runs it
# with use_nanbu = T (EPOCH's Nanbu-Perez), use_nanbu = F (Sentoku-Kemp) and use_collisions = F (the heating of the PIC noise).
begin:constant
  lambda0 = 1.0e-6
  n0 = 100.0 * critical(2.0 * pi * c / lambda0)
end:constant
begin:control
  nx = 48
  x_min = 0.0
  x_max = 48 * 0.25e-9
  t_end = 0.5e-12
  stdout_frequency = 20000
end:control
begin:boundaries
  bc_x_min = periodic
  bc_x_max = periodic
end:boundaries
begin:species
  name = electron
  charge = -1.0
  mass = 1.0
  nparticles_per_cell = 500
  number_density = n0
  temperature_ev = 100.0
end:species
begin:species
  name = proton
  charge = 1.0
  mass = 1836.15267
  nparticles_per_cell = 500
  number_density = n0
  temperature_ev = 10.0
end:species
begin:collisions
  use_collisions = T
  use_nanbu = T
  coulomb_log = 5.0
  collide = all
end:collisions
begin:output
  dt_snapshot = 10.0e-15
  temperature = always + species + no_sum
end:output
