# Case B: a low-emittance witness (eps_n = 0.1 um) in a linear laser wake, RZ (VLPL-RZ; VLPL-iRZ with
# numerics.solver = irip). The laser of bench/lwfa_fbpic (a0 = 1, 10 fs, waist 4 um, 0.01 n_c, lambda_p = 8 um) is
# guided over 0.5 mm by a matched parabolic channel, n(r) = n0 (1 + r^2 / r_ch^2 * dn), dn = 1 / (pi r_e w0^2 n0) = 0.405
# at r = w0 (cut at 9 um). The witness (10 MeV, 1 pC, eps_n = 0.1 um, matched; README) is loaded at t_start = 150 fs
# 4.5 um behind the pulse centre, at the peak of the accelerating field, with its self-field.
#   build/vlpl bench/emittance/rz_wake.deck
grid {
  geometry   = rz
  modes      = 2
  lambda0    = 0.8 um
  nz         = 320             # 16 um, dz = lambda / 16 (c dt = dz)
  nr         = 120             # 9 um, conducting wall
  dz         = 0.05 um
  dr         = 0.075 um
  boundary_z = open
  t_end      = 1700 fs         # 0.5 mm
}

numerics {
  solver = rip_cc
  shape  = 2
  pusher = higuera_cary
}

laser {
  a0           = 1
  polarization = x
  duration     = 10 fs         # intensity FWHM; delay 20 fs
  waist        = 4 um          # focus at z = 0
}

window {
  start = 45 fs                # the pulse centre 5.3 um behind the front edge, the first bucket in the box
}

species electrons {
  charge    = -1
  mass      = 1
  density   = 0.01
  zmin      = 13 um
  ppc_z     = 2
  ppc_r     = 2
  ppc_theta = 8
  density_function = (z < 20 um ? (z - 13 um) / (7 um) : 1) * (1 + 0.405 * (r < 9 um ? r : 9 um)^2 / (4 um)^2)
}

species protons {
  charge    = 1
  mass      = 1836
  density   = 0.01
  zmin      = 13 um
  ppc_z     = 2
  ppc_r     = 2
  ppc_theta = 8
  density_function = (z < 20 um ? (z - 13 um) / (7 um) : 1) * (1 + 0.405 * (r < 9 um ? r : 9 um)^2 / (4 um)^2)
}

species beam {
  charge    = -1
  mass      = 1
  density   = 0.00807          # 1 pC: Q / (e (2 pi)^1.5 sigma_r^2 sigma_z) = 1.41e19 cm^-3
  uz        = 20.55            # 10 MeV
  uth_x     = 0.333            # eps_n = sigma_r sigma_u = 0.1 um
  uth_y     = 0.333
  ppc_z     = 4
  ppc_r     = 4
  ppc_theta = 16
  # sigma_z = 0.3 um, sigma_r = 0.30 um (matched: the flattest sigma_y(t) of an RZ scan 0.245 .. 0.40 um, README), 4.5 um behind the pulse centre at t_start
  density_function = gauss(z - 34.3 um, 0.3 um) * gauss(r, 0.30 um)
  zmin      = 33.4 um
  zmax      = 35.2 um
  rmax      = 0.9 um
  self_field = true
  t_start   = 150 fs
}

diagnostic beam {
  species   = beam
  every     = 200
  bins      = 0
}

output {
  dir            = out_rz_wake
  every          = 200
  openpmd_every  = 2000
  openpmd_fields = E B
}
