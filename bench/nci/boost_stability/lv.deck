# Lee and Vay, Comput. Phys. Commun. 238, 102 (2019), the 1e19 cm^-3 case (their Table 1), 2D: a0 = 5, lambda0 = 0.8 um,
# k_p sigma = 5.3 (waist 8.9 um), k_p L = 2 (field exp(-zeta^2 / L^2), L = 3.36 um: intensity FWHM 13.2 fs), focus at the plasma
# entrance, linear 50 um entrance ramp, 500 um plasma, dy = 0.1 um, 2 x 2 particles per cell (theirs 4 x 4), shape 2 (theirs
# cubic). dx and the solver on the command line; boosted runs append a boost block (bench/nci/boost_stability/README.md, section 2c).
grid {
  geometry   = cartesian2d
  lambda0    = 0.8 um
  nx         = 1600            # 40 um at lambda / 32
  ny         = 512             # 51.2 um
  dx         = 0.025 um
  dy         = 0.1 um
  boundary_x = open
  t_end      = 1050 fs
}
numerics {
  solver = irip
  shape  = 2
  pusher = higuera_cary
}
laser {
  a0           = 5
  polarization = y
  duration     = 13.2 fs
  waist        = 8.9 um
  focus        = 45 um
  injection    = antenna
}
window {
  start    = 125 fs
  velocity = 1
}
species electrons {
  charge  = -1
  mass    = 1
  density = 0.005741           # 1e19 cm^-3 at 0.8 um
  xmin    = 45 um
  xmax    = 545 um
  density_function = x < 95 um ? (x - 45 um) / (50 um) : 1
  ppc_x   = 2
  ppc_y   = 2
}
species protons {
  charge  = 1
  mass    = 1836
  density = 0.005741
  xmin    = 45 um
  xmax    = 545 um
  density_function = x < 95 um ? (x - 45 um) / (50 um) : 1
  ppc_x   = 2
  ppc_y   = 2
}
lab_diagnostics {
  t_first   = 600.415 fs       # lab steps 7200, 9600, 12000 at lambda / 32 (openpmd_every 1200), x2 at lambda / 64
  t_every   = 200.138 fs
  count     = 3
  fields    = true
  species   = electrons
  gamma_min = 50
  select_uz = 49
  particles = true
}
output {
  dir           = out_lv
  every         = 40
  openpmd_every = 1200
  openpmd_fields = E B rho_electrons
}
